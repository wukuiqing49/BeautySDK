<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp" android:minHeight="48dp" android:clickable="true" android:focusable="true" android:background="@drawable/bg_preset_touch" android:descendantFocusability="blocksDescendants">
    <FrameLayout android:layout_width="match_parent" android:layout_height="76dp" android:background="@drawable/bg_preset_preview" android:clipToOutline="true" android:duplicateParentState="true">
        <com.beautysdk.demo.RoundedPreviewImageView android:id="@+id/preset_preview" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" android:importantForAccessibility="no" />
        <View android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_preset_selection" android:duplicateParentState="true" android:importantForAccessibility="no" />
        <ImageView android:id="@+id/preset_check" android:layout_width="18dp" android:layout_height="18dp" android:layout_gravity="top|end" android:layout_margin="3dp" android:src="@drawable/ic_preset_selected" android:importantForAccessibility="no" />
    </FrameLayout>
    <TextView android:id="@+id/preset_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="top|center_horizontal" android:minLines="1" android:maxLines="1" android:includeFontPadding="false" android:ellipsize="end" android:textSize="12sp" android:fontFamily="sans-serif" android:textColor="@color/effect_label" android:duplicateParentState="true" android:importantForAccessibility="no" />
    <TextView android:id="@+id/preset_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:minLines="1" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/camera_muted" android:visibility="gone" android:paddingTop="4dp" />
</LinearLayout>
