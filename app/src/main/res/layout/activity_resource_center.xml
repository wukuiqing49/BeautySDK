<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/camera_surface">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="16dp">
    <TextView android:id="@+id/resource_back" style="@style/CameraAction" android:text="@string/camera_back" />
    <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:gravity="center" android:text="@string/resources_page_title" android:textColor="@color/camera_text" android:textSize="20sp" android:textStyle="bold" />
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="20dp" android:paddingBottom="12dp" android:text="@string/resources_page_hint" android:textColor="@color/camera_muted" />
  <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
    <LinearLayout android:id="@+id/resource_categories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" />
  </HorizontalScrollView>
  <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scrollbars="none" android:clipToPadding="false" android:padding="16dp">
    <include android:id="@+id/resource_center" layout="@layout/view_resource_center" />
  </ScrollView>
</LinearLayout>