<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
  <TextView android:id="@+id/workshop_toggle" style="@style/CameraAction" android:layout_width="match_parent" android:layout_marginTop="12dp" android:text="@string/workshop_title" android:visibility="gone" />
  <LinearLayout android:id="@+id/workshop_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible">
    <TextView android:id="@+id/resource_network" style="@style/CameraAction" android:layout_width="match_parent" android:text="@string/resource_network"/>
<TextView android:id="@+id/resource_advanced" style="@style/CameraAction" android:layout_width="match_parent" android:text="@string/resource_advanced"/>
<LinearLayout android:id="@+id/workshop_navigation" android:visibility="gone" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
      <TextView style="@style/CameraAction" android:id="@+id/workshop_tab_material" android:layout_width="0dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="@string/workshop_section_material" />
      <TextView style="@style/CameraAction" android:id="@+id/workshop_tab_layout" android:layout_width="0dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="@string/workshop_section_layout" />
      <TextView style="@style/CameraAction" android:id="@+id/workshop_tab_export" android:layout_width="0dp" android:layout_weight="1" android:layout_marginHorizontal="3dp" android:text="@string/workshop_section_export" />
    </LinearLayout>
    <TextView style="@style/CameraLabel" android:text="@string/effect_resource_hint" />
    <TextView android:id="@+id/effect_resource_sample" style="@style/CameraAction" android:layout_width="match_parent" android:text="@string/effect_resource_sample" />
    <TextView android:id="@+id/effect_resource_status" style="@style/CameraLabel" android:text="@string/effect_resource_empty" android:textIsSelectable="true" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
      <TextView android:id="@+id/effect_resource_import" style="@style/CameraAction" android:layout_width="0dp" android:layout_weight="1" android:text="@string/effect_resource_import" />
      <TextView android:id="@+id/effect_resource_clear" style="@style/CameraAction" android:layout_width="0dp" android:layout_weight="1" android:text="@string/effect_resource_clear" />
    </LinearLayout>
    <TextView android:id="@+id/workshop_status" style="@style/CameraLabel" android:text="@string/workshop_empty" android:textIsSelectable="true" />
    <CheckBox android:id="@+id/workshop_enabled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/workshop_enabled" />
    <LinearLayout android:id="@+id/workshop_material_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
      <ImageView android:id="@+id/workshop_preview" android:layout_width="match_parent" android:layout_height="96dp" android:scaleType="fitCenter" android:contentDescription="@string/workshop_preview" />
      <TextView style="@style/CameraLabel" android:text="@string/workshop_hint" />
      <Spinner android:id="@+id/workshop_samples" android:layout_width="match_parent" android:layout_height="48dp" android:entries="@array/workshop_samples" android:contentDescription="@string/workshop_sample" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/workshop_load_sample" style="@style/CameraAction" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/workshop_load_sample" />
        <TextView android:id="@+id/workshop_import" style="@style/CameraAction" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="@string/workshop_import" />
      </LinearLayout>
    </LinearLayout>
    <LinearLayout android:id="@+id/workshop_editor" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
      <TextView style="@style/CameraLabel" android:text="@string/workshop_layer" />
      <Spinner android:id="@+id/workshop_layers" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="@string/workshop_layer" />
      <TextView style="@style/CameraLabel" android:text="@string/workshop_anchor" />
      <Spinner android:id="@+id/workshop_anchor" android:layout_width="match_parent" android:layout_height="48dp" android:entries="@array/workshop_anchors" android:contentDescription="@string/workshop_anchor" />
      <TextView style="@style/CameraLabel" android:text="@string/workshop_parameter" />
      <Spinner android:id="@+id/workshop_parameter" android:layout_width="match_parent" android:layout_height="48dp" android:entries="@array/workshop_parameters" android:contentDescription="@string/workshop_parameter" />
      <FrameLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:id="@+id/workshop_parameter_width" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="visible">
          <TextView android:id="@+id/workshop_width_value" style="@style/CameraLabel" android:text="@string/workshop_width" />
          <SeekBar android:id="@+id/workshop_width" android:layout_width="match_parent" android:layout_height="48dp" android:max="990" android:progress="240" android:contentDescription="@string/workshop_width" />
        </LinearLayout>
        <LinearLayout android:id="@+id/workshop_parameter_offset_x" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
          <TextView android:id="@+id/workshop_offset_x_value" style="@style/CameraLabel" android:text="@string/workshop_offset_x" />
          <SeekBar android:id="@+id/workshop_offset_x" android:layout_width="match_parent" android:layout_height="48dp" android:max="800" android:progress="400" android:contentDescription="@string/workshop_offset_x" />
        </LinearLayout>
        <LinearLayout android:id="@+id/workshop_parameter_offset_y" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
          <TextView android:id="@+id/workshop_offset_y_value" style="@style/CameraLabel" android:text="@string/workshop_offset_y" />
          <SeekBar android:id="@+id/workshop_offset_y" android:layout_width="match_parent" android:layout_height="48dp" android:max="800" android:progress="400" android:contentDescription="@string/workshop_offset_y" />
        </LinearLayout>
        <LinearLayout android:id="@+id/workshop_parameter_rotation" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
          <TextView android:id="@+id/workshop_rotation_value" style="@style/CameraLabel" android:text="@string/workshop_rotation" />
          <SeekBar android:id="@+id/workshop_rotation" android:layout_width="match_parent" android:layout_height="48dp" android:max="360" android:progress="180" android:contentDescription="@string/workshop_rotation" />
        </LinearLayout>
        <LinearLayout android:id="@+id/workshop_parameter_pivot_x" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
          <TextView android:id="@+id/workshop_pivot_x_value" style="@style/CameraLabel" android:text="@string/workshop_pivot_x" />
          <SeekBar android:id="@+id/workshop_pivot_x" android:layout_width="match_parent" android:layout_height="48dp" android:max="800" android:progress="450" android:contentDescription="@string/workshop_pivot_x" />
        </LinearLayout>
        <LinearLayout android:id="@+id/workshop_parameter_pivot_y" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
          <TextView android:id="@+id/workshop_pivot_y_value" style="@style/CameraLabel" android:text="@string/workshop_pivot_y" />
          <SeekBar android:id="@+id/workshop_pivot_y" android:layout_width="match_parent" android:layout_height="48dp" android:max="800" android:progress="450" android:contentDescription="@string/workshop_pivot_y" />
        </LinearLayout>
      </FrameLayout>
      <TextView android:id="@+id/workshop_reset" style="@style/CameraAction" android:layout_gravity="end" android:text="@string/workshop_reset" />
    </LinearLayout>
    <LinearLayout android:id="@+id/workshop_export_section" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
      <TextView style="@style/CameraLabel" android:text="@string/workshop_export_hint" />
      <TextView android:id="@+id/workshop_save_load" style="@style/CameraAction" android:layout_width="match_parent" android:text="@string/workshop_save_load" />
      <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
        <TextView android:id="@+id/workshop_export_zip" style="@style/CameraAction" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:text="@string/workshop_export_zip" />
        <TextView android:id="@+id/workshop_export_json" style="@style/CameraAction" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:text="@string/workshop_export_json" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
</LinearLayout>
