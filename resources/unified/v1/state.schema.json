{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stateVersion",
    "parameters",
    "selections",
    "enabled"
  ],
  "properties": {
    "stateVersion": {
      "const": 1
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beauty.smoothing": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "beauty.whitening": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "beauty.rosy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "color.brightness": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "color.contrast": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "color.saturation": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "color.sharpening": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reshape.slimFace": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reshape.bigEyes": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reshape.slimNose": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reshape.chinLength": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "reshape.mouthSize": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "makeup.lipstick": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "makeup.blusher": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "makeup.eyelashes": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "selections": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_.]{0,63}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "null"
          },
          {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        ]
      }
    },
    "enabled": {
      "type": "boolean"
    }
  }
}
