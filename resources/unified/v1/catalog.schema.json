{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "resourceCatalogVersion",
    "resources"
  ],
  "properties": {
    "resourceCatalogVersion": {
      "const": 1
    },
    "resources": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "manifest",
          "url",
          "previewUrl",
          "bytes",
          "sha256"
        ],
        "properties": {
          "manifest": {
            "$ref": "resource.schema.json"
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          },
          "previewUrl": {
            "type": "string",
            "pattern": "^https://"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
